* text=auto

# Source and documentation use LF to avoid Windows/WSL newline churn.
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf
*.bib text eol=lf
*.tex text eol=lf

# PowerShell helpers are friendlier on Windows with CRLF.
*.ps1 text eol=crlf

# Generated/binary artifacts.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
*.docx binary
*.7z binary
*.zip binary
*.parquet binary
