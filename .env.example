# Copy this file to .env for local runs.
# Keep the real .env private; it is ignored by git.

# Choose one backend for live translation: deepseek, openai, anthropic, or ollama.
NL2OCEL_BACKEND=deepseek

# Optional explicit model override. Leave blank to use the project default.
NL2OCEL_MODEL=

# Optional generic override used by the Flask API. Leave blank unless needed.
NL2OCEL_API_KEY=

# Provider-specific keys. Set only the one you use.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
